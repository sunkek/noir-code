# NoiR Code gateway config (envconfig prefix NOIRCODE_API_). The stack is
# stateless — no DB/broker/cache — so this is the whole surface. docker-compose
# sets these inline; this file documents them for host runs / overrides.

export NOIRCODE_API_HEALTH_PORT="3333"
export NOIRCODE_API_HEALTH_INTERVAL="30s"

export NOIRCODE_API_LOG_LEVEL="debug"
export NOIRCODE_API_LOG_SOURCE="false"

export NOIRCODE_API_FIBER_HOST="0.0.0.0"
export NOIRCODE_API_FIBER_PORT="8000"
export NOIRCODE_API_FIBER_PATH_PREFIX="/api/v1"
export NOIRCODE_API_FIBER_BODY_LIMIT_MB="20"
# Server timeouts (slowloris protection). 0 disables a given timeout.
export NOIRCODE_API_FIBER_READ_TIMEOUT="15s"
export NOIRCODE_API_FIBER_WRITE_TIMEOUT="30s"
export NOIRCODE_API_FIBER_IDLE_TIMEOUT="120s"
# CORS. "*" is fine for local dev; set explicit origins for a public deploy.
export NOIRCODE_API_FIBER_CORS_ALLOW_ORIGINS="*"
export NOIRCODE_API_FIBER_CORS_ALLOW_METHODS="*"
export NOIRCODE_API_FIBER_CORS_ALLOW_HEADERS="*"
# Swagger UI + spec served at /api/v1/docs when set. Leave empty to disable.
export NOIRCODE_API_FIBER_SWAGGER_FILE_PATH="./docs/swagger.json"

# Imaging sidecar (Python FastAPI) that owns the encode/decode pipeline.
export NOIRCODE_API_IMAGING_BASE_URL="http://localhost:8001"
export NOIRCODE_API_IMAGING_TIMEOUT="30s"

# Per-IP rate limit on the encode/decode endpoints.
export NOIRCODE_API_RATE_LIMIT_MAX="30"
export NOIRCODE_API_RATE_LIMIT_WINDOW="1m"
